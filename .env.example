# Copy to `.env.local` for local Next.js. Never commit real secrets.
# On Vercel: Project → Settings → Environment Variables (Production + Preview).

# --- Tapstitch Open Platform (POD / dropship) ---
# Docs: https://www.tapstitch.com/developers/docs/openapi
# Portal: create a private token under Developer Portal → API tokens.

# Feature flag — leave false/unset until tokens are set (site boots without Tapstitch).
TAPSTITCH_ENABLED=false

# Private token from Developer Portal (Authorization: Bearer …)
TAPSTITCH_ACCESS_TOKEN=

# Alias accepted by the client (same as ACCESS_TOKEN)
# TAPSTITCH_API_TOKEN=

# Optional store scope header X-PF-Store-Id (store-scoped portal tokens)
# TAPSTITCH_STORE_ID=

# API base — default is official public server; override only if Tapstitch documents otherwise
# TAPSTITCH_API_BASE_URL=https://openapi.tapstitch.com

# Webhook HMAC secret_key from Developer Portal → Webhooks (required in production)
# TAPSTITCH_WEBHOOK_SECRET=

# Optional portal public_key (reserved; confirm verify scheme in portal simulator)
# TAPSTITCH_WEBHOOK_PUBLIC_KEY=

# --- Payments (Stripe first; other providers later via PAYMENT_PROVIDER) ---
# Dashboard: https://dashboard.stripe.com/apikeys
# Leave PAYMENTS_ENABLED=false until keys are set (site boots without Stripe).

PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=stripe
PAYMENTS_CURRENCY=usd

# Secret key (sk_test_… or sk_live_…) — server only, never NEXT_PUBLIC_
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_…) from Stripe Dashboard → Webhooks
# Endpoint URL: https://<your-domain>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Optional — needed later for Stripe Elements; Checkout redirect works without it
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Canonical site origin for success/cancel URLs if Origin header is missing
# NEXT_PUBLIC_SITE_URL=https://www.ghanatotheworld.com
